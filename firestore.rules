rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        request.auth.token.email == 'workumesafint2@gmail.com'
      );
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // User Profile Documents
    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();
      allow create: if isOwner(userId) &&
        request.resource.data.id == userId &&
        (request.resource.data.role == 'user' || isAdmin() || request.auth.token.email == 'workumesafint2@gmail.com');
      allow update: if (isOwner(userId) || isAdmin()) &&
        request.resource.data.id == resource.data.id &&
        (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['role']) || isAdmin());
      allow delete: if isAdmin();

      // Subcollection: Custom Pronunciation Dictionary Items
      match /dictionary/{entryId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }
    }

    // Authoritative Admin Roles
    match /admins/{userId} {
      allow read: if isSignedIn();
      allow write: if isAdmin() || (isSignedIn() && request.auth.token.email == 'workumesafint2@gmail.com');
    }

    // User Saved News Scripts
    match /savedScripts/{scriptId} {
      allow get: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() &&
        isValidId(scriptId) &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.id == scriptId;
      allow update: if isSignedIn() &&
        request.resource.data.userId == resource.data.userId &&
        (resource.data.userId == request.auth.uid || isAdmin());
      allow delete: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
    }
  }
}
